 "name": "09_grover",
 "code": "import pennylane as qml\nfrom pennylane import numpy as np\n\nn = 3\ndev = qml.device(\"default.qubit\", wires=n)\n\n\ndef oracle():\n    # Marque l'état |101⟩ en inversant son signe\n    qml.PauliX(wires=1)\n    qml.ctrl(qml.PauliZ(wires=2), control=[0, 1])\n    qml.PauliX(wires=1)\n\n\ndef diffusion():\n    for w in range(n):\n        qml.Hadamard(wires=w)\n        qml.PauliX(wires=w)\n    qml.ctrl(qml.PauliZ(wires=2), control=[0, 1])\n    for w in range(n):\n        qml.PauliX(wires=w)\n        qml.Hadamard(wires=w)\n\n\n@qml.set_shots(1000)\n@qml.qnode(dev)\ndef grover():\n    for w in range(n):\n        qml.Hadamard(wires=w)\n    for _ in range(2):\n        oracle()\n        diffusion()\n    return qml.counts()\n\n\nprint(grover())\n",
